<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.BmiController">
   <children>
      <Label layoutX="209.0" layoutY="38.0" text="BMI CALCULATOR">
