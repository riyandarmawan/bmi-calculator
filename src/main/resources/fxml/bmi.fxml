      <TextField fx:id="tinggiBadanInput" layoutX="209.0" layoutY="121.0" prefHeight="25.0" prefWidth="207.0" />
      <Label layoutX="211.0" layoutY="163.0" text="Berat Badan (kg)" />
      <TextField fx:id="beratBadanInput" layoutX="209.0" layoutY="187.0" prefHeight="25.0" prefWidth="207.0" />
      <Button fx:id="hitungButton" layoutX="211.0" layoutY="227.0" mnemonicParsing="false" onAction="#calculateBmi" prefHeight="25.0" prefWidth="207.0" text="Hitung" />
      <Label fx:id="hasilLabel" alignment="TOP_LEFT" layoutX="211.0" layoutY="272.0" prefHeight="107.0" prefWidth="207.0" text="hasil" wrapText="true" />
